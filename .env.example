# Copia este archivo como ".env" (junto al programa) y rellena los valores.
# ".env" esta en .gitignore: NO lo subas nunca al repositorio.
BILLX_DB_HOST=100.x.y.z
BILLX_DB_USER=billx_app
BILLX_DB_PASSWORD=cambia_esta_clave
BILLX_DB_NAME=billx_db
BILLX_DB_PORT=3306
BILLX_DB_TIMEOUT=5

# Solo para init_esquema.py / migraciones (usuario con permisos DDL). Opcional.
# BILLX_DB_ADMIN_USER=billx_admin
# BILLX_DB_ADMIN_PASSWORD=otra_clave_distinta

# Solo desarrollo: 1 = crear/ampliar tablas al arrancar la app
# BILLX_AUTO_INIT_DB=0

# Si mysqldump no esta en el PATH de Windows:
# BILLX_MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
